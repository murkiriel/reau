# Text files are LF in the repository and in a clone (gradlew has to be, to run on Linux and macOS); Windows scripts stay CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# Binaries are left alone.
*.png binary
*.jar binary
*.ttf binary
*.webp binary
# Fuzz seeds are raw bytes (HTTP heads keep their CRLF).
app/src/test/resources/com/reau/app/fuzz/** binary
# The protobuf classes copied from OpenCfMoto are generated code: kept out of the language bar and the diffs on GitHub.
app/src/main/java/com/reau/app/aa/proto/** linguist-generated
